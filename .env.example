# ==============================================================================
# Braynix Studios - AI Interactive Whiteboard Tutor Environment Variables
# ==============================================================================

# Primary AI Provider: NVIDIA NIM (Hosted Inference API)
# Get a free developer API key with 1000 credits from: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-key-here

# Selected model with strong structured JSON & educational reasoning capabilities
# Options: nvidia/nemotron-3.5-lightning-30b-a3b (recommended), nvidia/nemotron-3.5-bolt-e4b
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Base URL for NVIDIA NIM OpenAI-compatible API
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
